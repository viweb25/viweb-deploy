# Copy to /opt/viweb/.env on the server and fill in. Never commit the real file.
# chmod 600 /opt/viweb/.env

# Public hostname. Point an A record for it at the server's IP before the first deploy.
DOMAIN=app.example.com
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=ops@example.com

# Database. Generate the password with: openssl rand -hex 32
# Use hex only, so the password is safe inside the database URL.
POSTGRES_USER=viweb
POSTGRES_DB=viweb
POSTGRES_PASSWORD=

# Optional tuning. Defaults suit a 4 vCPU / 8 GB server.
# API_WORKERS=2
# INFERENCE_CPUS=2
# INFERENCE_MEMORY=3g
# TRAINING_CPUS=2
# TRAINING_MEMORY=6g
# VI_TRAINING_EPOCHS=100
# VI_YOLO_WEIGHTS=/models/best.pt

# Days of nightly database backups to keep in /opt/viweb/backups.
# BACKUP_KEEP_DAYS=14
