# Which build of each service runs in production. One line per repository.
# Each tag is sha-<first 12 characters of the commit>, built by that repo's CI on main.
# Change these with scripts/release.sh, open a pull request, and merge it to deploy.
# To roll back, revert the merge commit: the previous tags deploy again.
REGISTRY=ghcr.io/viweb25
FRONTEND_TAG=main
API_TAG=main
DB_TAG=main
INFERENCE_TAG=main
